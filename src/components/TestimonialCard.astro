---
interface Props {
  quote: string;
  excerpt: string;
  person: string;
  role: string;
  label?: string;
  link?: string;
  image?: string;
}

const { quote, excerpt, person, role, label, link, image } = Astro.props;
const paragraphs = quote.split("\n\n");
const modalId = `testimonial-${person.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const modalTitleId = `${modalId}-title`;
---

<article class="panel card">
  {image && <img class="testimonial-avatar" src={image} alt={person} />}
  <p class="quote">{excerpt}</p>
  <button class="testimonial-trigger" type="button" data-dialog-id={modalId}>
    See full testimonial
  </button>
  <dialog class="testimonial-dialog" id={modalId} aria-labelledby={modalTitleId}>
    <div class="testimonial-dialog-inner">
      <div class="testimonial-dialog-header">
        <div>
          <span class="eyebrow">Full testimonial</span>
          <h3 id={modalTitleId}>{person}</h3>
        </div>
        <form method="dialog">
          <button class="dialog-close" type="submit" aria-label={`Close ${person}’s testimonial`}>
            <span aria-hidden="true">×</span>
          </button>
        </form>
      </div>
      <div class="full-testimonial">
      {
        paragraphs.map((paragraph) => (
          <p>
            {paragraph.split("\n").map((line, index, lines) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </p>
        ))
      }
      </div>
      <p class="testimonial-dialog-role">
        <strong>{person}</strong> · {role}{label && ` · ${label}`}
      </p>
    </div>
  </dialog>
  <div class="card-footer">
    <div class="card-person">
      <p><strong>{person}</strong></p>
      <p class="meta">{role}</p>
      {label && <p class="meta">{label}</p>}
    </div>
    {link && (
      <a class="icon-link" href={link} target="_blank" rel="noreferrer" aria-label={`${person} on LinkedIn`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.94 8.5H3.56V20h3.38V8.5Zm.22-3.56c0-1.08-.82-1.94-1.91-1.94s-1.9.86-1.9 1.94c0 1.05.81 1.91 1.88 1.91h.02c1.11 0 1.91-.86 1.91-1.91ZM20 13.05c0-3.46-1.85-5.07-4.32-5.07-1.99 0-2.88 1.09-3.38 1.86V8.5H8.93c.05.89 0 11.5 0 11.5h3.37v-6.42c0-.34.02-.68.12-.92.27-.68.89-1.39 1.93-1.39 1.36 0 1.91 1.05 1.91 2.6V20H20v-6.95Z"
            fill="currentColor"
          />
        </svg>
      </a>
    )}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-dialog-id]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(trigger.dataset.dialogId ?? "") as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>(".testimonial-dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
